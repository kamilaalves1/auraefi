{
  "name": "vertex-control-center",
  "version": "1.0.0",
  "description": "Vertex Control Center — AI Agent Orchestration Dashboard by Silver Snow Studios",
  "scripts": {
    "verify:node": "node scripts/check-node-version.mjs",
    "api:parity": "node scripts/check-api-contract-parity.mjs --root . --openapi openapi.json --ignore-file scripts/api-contract-parity.ignore",
    "api:parity:json": "node scripts/check-api-contract-parity.mjs --root . --openapi openapi.json --ignore-file scripts/api-contract-parity.ignore --json",
    "mc": "node scripts/mc-cli.cjs",
    "dev": "npm run verify:node && next dev --hostname 127.0.0.1 --port 3000",
    "build": "npm run verify:node && next build",
    "start": "npm run verify:node && next start --hostname 0.0.0.0 --port 3000",
    "start:standalone": "npm run verify:node && bash scripts/start-standalone.sh",
    "deploy:standalone": "npm run verify:node && bash scripts/deploy-standalone.sh",
    "lint": "npm run verify:node && eslint .",
    "typecheck": "npm run verify:node && tsc --noEmit",
    "test": "npm run verify:node && vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "npm run verify:node && playwright test",
    "test:all": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "quality:gate": "npm run test:all",
    "postinstall": ""
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "@scalar/api-reference-react": "^0.8.70",
    "@xyflow/react": "^12.11.2",
    "autoprefixer": "^10.5.4",
    "mysql2": "^3.14.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "next": "^16.2.10",
    "next-intl": "^4.13.2",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "postcss": "^8.5.20",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "reactflow": "^11.11.4",
    "reagraph": "^4.32.0",
    "recharts": "^3.9.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "cross-env": "^7.0.3",
    "jsdom": "^26.1.0",
    "pino-pretty": "^13.1.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "gateway",
    "agent",
    "orchestration",
    "dashboard",
    "nextjs"
  ],
  "author": "Builderz Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/builderz-labs/mission-control.git"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "vue-demi"
    ]
  },
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065"
}
